# Copy to .env (never commit .env).

# Local (default): Billing API and MCP server running on this machine
API_BASE_URL=http://localhost:8000/api/v1
MCP_URL=http://127.0.0.1:8001/mcp

# Azure (step 5): all REST calls must go through the API Gateway
# API_BASE_URL=https://<apim-name>.azure-api.net/api/v1
# APIM_SUBSCRIPTION_KEY=<only if the APIM product requires a key>
# MCP_URL=https://<mcp-app>.<region>.azurecontainerapps.io/mcp

# LLM: "rule-based" (no LLM, free, used by tests) or "gemini"
LLM_PROVIDER=rule-based
# GEMINI_API_KEY=<key from https://aistudio.google.com/apikey>
# GEMINI_MODEL=gemini-3.5-flash-lite
